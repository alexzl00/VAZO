# The canonical origin used for published SEO pages. Configure in Vercel
# under Project Settings > Environment Variables (Production and Preview).
VITE_SITE_URL=https://vazo.vercel.app

# off (default): no guide URLs emitted; production-safe.
# preview: one draft demo + index, noindex; Preview deployments ONLY.
# public: Phase 2, ONLY after real reviewed articles are published.
PORADNIK_RELEASE_MODE=off
